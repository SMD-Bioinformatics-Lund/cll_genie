# Copy to .env_dev and replace the secret and database host.
SECRET_KEY='replace-with-a-development-secret'
DB_HOST='replace-with-a-container-reachable-database-host'
DB_PORT=27017
DB_NAME=cll_genie_dev
# Required: choose an available development port distinct from production.
PORT_NBR=''
CONTAINER_NAME=cll_genie_app_dev
SCRIPT_NAME=''
APP_DNS=''
# These directories must already exist on the Docker host.
RESULTS_DIR=/data/lymphotrack/cll_results_dev
LOGS_DIR=/data/lymphotrack/logs_dev
LYMPHOTRACK_RESULTS_DIR=/data/lymphotrack/results/lymphotrack_dx
# Set APP_DNS if your Docker host requires an explicit DNS server.
