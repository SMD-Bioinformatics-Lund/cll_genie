# CLL Genie configuration. Copy this file to .env and adjust every value for
# the deployment. Docker Compose does not provide fallback values.
APP_NAME=CLL Genie
APP_VERSION=2.0.0
ENVIRONMENT=development
APPLICATION_PREFIX=/cll_genie
API_PREFIX=/cll_genie/api/v1
CLL_GENIE_PORT=8080
MONGO_DEV_PORT=27017

# Databases and queues. When using `--profile mongo`, set MONGODB_URI to
# mongodb://mongo:27017.
MONGODB_URI=mongodb://mongo.example.internal:27017
APPLICATION_DATABASE=cll_genie
USERS_COLLECTION=users
SESSIONS_COLLECTION=cll_genie_sessions
SAMPLES_COLLECTION=samples
RESULTS_COLLECTION=vquest_results
JOBS_COLLECTION=analysis_jobs
COUNTERS_COLLECTION=submission_counters
ARTIFACTS_COLLECTION=artifacts
REPORTS_COLLECTION=reports
RULES_COLLECTION=report_rules
REDIS_URL=redis://redis:6379/0
CELERY_EAGER=false

# Authentication and sessions
AUTH_PROVIDERS=ldap,local
SESSION_COOKIE_NAME=cll_genie_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LDAP configuration. These are non-production examples. Remove ldap from
# AUTH_PROVIDERS when LDAP is not used.
LDAP_HOST=ldap://ldap.example.internal
LDAP_BASE_DN="dc=example,dc=internal"
LDAP_USER_LOGIN_ATTR=mail
LDAP_USE_SSL=false
LDAP_USE_TLS=true
LDAP_BINDDN="cn=service-account,dc=example,dc=internal"
LDAP_SECRET=replace-me
LDAP_USER_DN=ou=people
LDAP_CONNECT_TIMEOUT_SECONDS=5

# Filesystem paths. Use absolute host paths; Compose mounts each path at the
# same absolute location in the containers. LOG_ROOT and ARTIFACT_ROOT must be
# writable by UID/GID 10001; the two input roots must be readable.
LOG_ROOT=/data/cll-genie/logs
ARTIFACT_ROOT=/data/cll-genie/artifacts
LYMPHOTRACK_RESULTS_ROOT=/data/lymphotrack/results/lymphotrack_dx
RUN_ROOT=/data/MiSeq
RUN_RTA_MARKER=RTAComplete.txt
RUN_PIPELINE_MARKER=cdm.done
RUN_CLL_GENIE_MARKER=cll_genie.done

# External services
IMGT_VQUEST_URL=https://www.imgt.org/IMGT_vquest/analysis
IMGT_CONNECT_TIMEOUT_SECONDS=5
IMGT_READ_TIMEOUT_SECONDS=180

# API and reporting behavior
PAGE_SIZE_MAX=100
MUTATION_BORDERLINE_LOWER=97.0
MUTATION_BORDERLINE_UPPER=97.99
PDF_ANALYSIS_RUN_AT=SMD, Molecular Diagnostics
