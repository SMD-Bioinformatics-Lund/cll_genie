# CLL Genie configuration. Copy to .env; never commit credentials.
APP_VERSION=2.0.0
ENVIRONMENT=development
CLL_GENIE_PORT=8080

# By default, use the local MongoDB installed on your system. 
# If running mongo in docker (via --profile mongo), use: mongodb://mongo:27017
MONGODB_URI=mongodb://host.docker.internal:27017

# Redis is used internally by Celery and is always provided by Docker
REDIS_URL=redis://redis:6379/0

# Authentication Providers (local, ldap)
AUTH_PROVIDERS=local,ldap
SESSION_TTL_SECONDS=28800

# LDAP Configuration
LDAP_URI=ldaps://ldap.example.internal:636
LDAP_BASE_DN=ou=people,dc=example,dc=internal
LDAP_USER_FILTER=(uid={username})
LDAP_BIND_DN=uid=cll-genie,ou=services,dc=example,dc=internal
LDAP_BIND_PASSWORD=replace-me
LDAP_CONNECT_TIMEOUT_SECONDS=5

# Filesystem Paths
CLL_ARTIFACT_ROOT=./var/artifacts
LYMPHOTRACK_RESULTS_ROOT=/data/lymphotrack/results/lymphotrack_dx
MISEQ_RUN_ROOT=/data/MiSeq

# External Services
IMGT_VQUEST_URL=https://www.imgt.org/IMGT_vquest/analysis

# PDF Report Config
PDF_ANALYSIS_RUN_AT=SMD, Molecular Diagnostics
