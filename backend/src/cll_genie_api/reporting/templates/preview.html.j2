<style>.preview{background:#ffdada;border:1px solid #db7474;padding:10px;text-align:center;font-weight:bold}@media print{.preview{display:none}}</style>

  <div class="preview" id="preview-banner">
    <div style="margin-bottom: 10px;">*** PREVIEW OF REPORT ***</div>
    <button id="save-btn" style="padding: 8px 16px; font-size: 13px; font-weight: bold; cursor: pointer; background: #DF7849; color: white; border: none; border-radius: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
      Save HTML Report
    </button>
    <div id="save-msg" style="display: none; margin-top: 8px; font-size: 12px;"></div>
  </div>
  <script>
    document.getElementById('save-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('save-btn');
      const msg = document.getElementById('save-msg');
      btn.disabled = true;
      btn.innerText = 'Saving...';
      
      try {
        let url = {{ save_url|tojson }};
        if (url.startsWith('/')) {
            url = window.location.origin + url;
        }
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': {{ csrf_token|tojson }}
          },
          body: JSON.stringify({ summary: {{ summary|tojson }} })
        });
        
        if (response.ok) {
          const data = await response.json();
          msg.innerText = 'Report saved successfully! You can close this window.';
          msg.style.display = 'block';
          msg.style.color = '#166534';
          btn.style.display = 'none';
          document.getElementById('preview-banner').style.background = '#dcfce7';
          document.getElementById('preview-banner').style.borderColor = '#22c55e';
          
          // Update the Rapport-ID in the DOM from PREVIEW to the real ID
          if (data && data.report_id) {
            const reportIdStr = typeof data.report_id === 'object' && data.report_id.$oid ? data.report_id.$oid : data.report_id;
            const ths = document.querySelectorAll('th');
            for (let th of ths) {
              if (th.innerText.includes('Rapport-ID')) {
                const td = th.nextElementSibling;
                if (td) td.innerText = reportIdStr;
              }
            }
          }
          
          if (window.opener) {
            window.opener.postMessage({ type: 'REPORT_SAVED' }, window.location.origin);
          }
        } else {
          throw new Error('Failed to save report');
        }
      } catch (e) {
        btn.disabled = false;
        btn.innerText = 'Save HTML Report';
        msg.innerText = 'Error saving report: ' + e.message;
        msg.style.display = 'block';
        msg.style.color = '#991b1b';
      }
    });
  </script>
